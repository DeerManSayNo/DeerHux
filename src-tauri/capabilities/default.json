{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main window",
  "windows": ["main", "file-preview", "quick-session", "selection-assistant"],
  "remote": {
    "urls": [
      "http://localhost:30141",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "allow-read-clipboard-file-paths",
    "allow-set-startup-theme",
    "allow-terminal-create",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:webview:allow-create-webview-window",
    "allow-get-live-island-setting-command",
    "allow-set-live-island-setting",
    "allow-get-live-island-scale-command",
    "allow-set-live-island-scale",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "shell:allow-open"
  ]
}
